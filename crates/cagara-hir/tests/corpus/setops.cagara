# Every set operation, in both spellings.
#
# The examples had no set operation at all, which is why a reversed `except`
# reached users: none of the golden files exercised the piped form.
#
# A stage takes its subject last, and for a set operation the subject is the
# left operand, so `users & except admins` and `except admins users` are the
# same query — `users EXCEPT admins`. Both spellings are kept here so a
# snapshot pins that they agree; `except` is the only one where a disagreement
# would be observable, because `union` and `intersect` are symmetric.
users : query { id = int, name = string } = table "public" "users"
admins : query { id = int, name = string } = table "public" "admins"

union_named = users & union admins
union_op = users &| admins
union_direct = union users admins

union_all = users & unionAll admins
intersect_named = users & intersect admins

# The one where order is observable: these two are the same query.
except_named = users & except admins
except_op = users &~ admins
