full: rejected
semi: query { id = int, name = string } => SELECT t1.id, t1.name FROM (SELECT id, name FROM public.users) AS t1 WHERE (EXISTS (SELECT t2.id, t2.user_id, t2.amount FROM (SELECT id, user_id, amount FROM public.orders) AS t2 WHERE (t1.id = t2.user_id)))
anti: query { id = int, name = string } => SELECT t1.id, t1.name FROM (SELECT id, name FROM public.users) AS t1 WHERE (NOT EXISTS (SELECT t2.id, t2.user_id, t2.amount FROM (SELECT id, user_id, amount FROM public.orders) AS t2 WHERE (t1.id = t2.user_id)))
