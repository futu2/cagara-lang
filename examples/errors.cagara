#! Each query here is rejected at compile time.
#!
#! The point of the file is the diagnostics, so every definition below is
#! deliberately wrong in one way.

## The table the three broken queries below are written against.
users : query { id = int, name = string, age = int } = table "public" "users"

## Rejected: `sum` is an aggregate, and an aggregate cannot take another
## aggregate as its argument.
nested = users & agg { t = sum (sum .age) }

## Rejected: `name` is neither grouped nor aggregated, so it has no single
## value per group.
ungrouped = users & agg { n = count, name = .name }

## Rejected: there is no `salary` column — the message lists what there is.
missing = users & where (.salary > 1)
