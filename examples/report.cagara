#! One report per feature: filtering, projection, aggregation, windows, joins,
#! nulls, and the operator shorthands.
#!
#! The prelude is imported automatically. Run it to see the SQL `main` compiles
#! to (`cagara examples/report.cagara`), and read the file as a tour.

## The user table, with its columns named by hand: a table's row type comes from
## its signature, so `users` is what every `.name` below is checked against, and
## the `##` blocks here are the reference for those columns.
users : query {
    ## The primary key.
    id = int,
    ## Display name; two people may share one.
    name = string,
    ## Age in years, which is why `addYears` below is a date function only.
    age = int,
    ## Whether the account is active. Filtering on it is `&? .active`.
    active = bool
  } = table "public" "users"

## The order table: one row per order.
orders : query {
    ## The primary key.
    id = int,
    ## The user who placed it. Joins reach this side as `.>user_id`.
    user_id = int,
    ## The charged amount, in the currency of the source table — a `float`, so
    ## sums of it are approximate.
    amount = float,
    ## Free text the source system writes; filterable but not enumerable.
    status = string,
    ## The day the order was placed — a `date`, not a `timestamp`, so it has no
    ## hour to truncate.
    created_at = date
  } = table "public" "orders"

## Filtering, projection, ordering and paging in one pipeline. `select` renames
## (`label`) and recomputes (`next_age`) as it projects; columns not listed are
## dropped, which is why `select` is the projection and `update` is the merge.
adults = users
  & where (.age >= 18 && .active)
  & select { id = .id, label = upper .name, next_age = .age + 1 }
  & order [asc .label]
  & limit 10

## Aggregation, then a filter on the aggregate's own result. A filter after an
## aggregate wraps a derived table, since SQL cannot filter an aggregate in the
## same SELECT. Folding it into a `HAVING` is a query-shape optimization this
## compiler does not perform; see "Current boundaries" in docs/PLAN.md.
##
## `coalesce 0.0 .revenue` is there because `sum` is `maybe`: every aggregate
## that can be NULL says so in its type.
revenue = orders
  & where (.status == "paid")
  & agg { user_id = group .user_id, revenue = sum .amount, n = count }
  & where (.n >= 5)
  & order [desc (coalesce 0.0 .revenue)]

## A window spec, shared by the definitions below: partition by user, newest
## first. Written once because two windows want the same ordering.
spec = { partition = [.user_id], order = [desc .created_at] }

## The latest three orders per user: number the rows within each partition, then
## filter on the number. The filter cannot be in the same `select` — a window
## function is evaluated after filtering — so it is the next stage.
latest = orders
  & select { id = .id, user_id = .user_id, rn = rowNumber spec }
  & where (.rn <= 3)

## A running total per user: `sumOver` with `runningFrame`, which is the frame
## from the partition's start to the current row.
running = orders
  & select {
    id = .id,
    total =
      sumOver { partition = [.user_id], order = [asc .created_at], frame = runningFrame } .amount
  }

## A join, read in stages: the names are made unique before the join (both
## tables have an `id`), then the joined row is projected. `.<x` is the left
## side of the join, `.>x` the right.
order_names = orders
  & select { .user_id, .amount, order_id = .id }
  & innerJoin users (.<user_id == .>id)
  & select { order_id = .order_id, name = .name, amount = .amount }

## Nulls are explicit: the right side of a left join is `maybe`, and so are
## `sum` / `avg` / `min` / `max`. Operators take non-null values, so each one is
## `coalesce`d — `0.0` for money, and a count built from a test rather than
## `count`, so that a user with no orders is 0 and not NULL.
user_totals = users
  & leftJoin orders (.<id == .>user_id)
  & agg {
    id = group .id,
    total = coalesce 0.0 (sum (coalesce 0.0 .amount)),
    orders = coalesce 0 (sum (ifThenElse (isNotNull .user_id) 1 0))
  }

## The same report as `user_totals`, for active users, written with the operator
## shorthands: `&?` where, `&=` select, `&+` update, `&*` agg, `&.` order, `&-`
## limit; joins `?` innerJoin, `<?` left, `?>` right, `<?>` full; `??` coalesce.
active_totals = users
  &? .active
  & (orders & select { .user_id, .amount, .status, .created_at }) <? .<id == .>user_id
  &* { id = group .id, name = group .name, total = sum (coalesce 0.0 .amount) ?? 0.0 }
  &. [desc .total]
  &- 20

## The aggregate report is what `cagara report.cagara` prints: a file runs one
## query, and `main` is how it says which.
main = revenue
