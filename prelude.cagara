# Cagara prelude — imported into every module automatically.
#
# The Rust core provides only the `__` primitives (relational operators,
# window frames) and the `sql "..."` template mechanism. Everything
# below is ordinary Cagara. Type signatures on `sql` templates are required:
# they give the arity and whether the result is a scalar (`expr r a`), an
# aggregate (`agg (expr r a)`), or a window function (`win (expr r a)`).
# All signatures are checked by the type checker.
#
# A name defined more than once (each with a signature) is overloaded: the
# type checker picks the definition whose signature fits each use.
#
# Functions take the value they operate on last, so a partial application is
# a reusable transformation: `addDays 7`, `coalesce 0`, `contains "@"`,
# `.name & trim >>> lower`.

# ── combinators ────────────────────────────────────────────────────────────

# The fixities are Haskell's, where these are the standard combinators: `$` is
# the loosest operator of all, application with its arguments reversed; `&` is
# `Data.Function.(&)`, reverse application; and `>>>` / `<<<` are the two
# directions of composition (`Control.Category`), which bind tighter than every
# other operator so `f >>> g $ x` is `(f >>> g) $ x`.
#
# `f >>> g` is `f` then `g`; `f <<< g` is `g` then `f`. A pipeline read left to
# right uses `>>>` (`.name & trim >>> lower`), and `<<<` is the mirror for a
# composition written the other way round — the same pair as `&` and `$`.
#
# `&` doubles as the query pipeline, so its level is also the level the stage
# shorthands are declared at — see below. Precedence runs from 0 (loosest) to
# 250 (tightest); application itself is tighter than any operator.
infixr 0 $
infixl 1 &
infixr 23 >>>
infixr 23 <<<

_&_ = x => f => f x
_$_ = f => x => f x
_>>>_ = f => g => x => g (f x)
_<<<_ = f => g => x => f (g x)
id = x => x

# ── scalar SQL expressions ─────────────────────────────────────────────────

# Typed conditionals lower to a searched SQL CASE expression. Both branches
# are checked at the same expression phase, so this also works after agg or
# select when the surrounding stage permits that phase.
ifThenElse : expr r bool -> expr r a -> expr r a -> expr r a = sql "CASE WHEN $1 THEN $2 ELSE $3 END"
caseWhen = ifThenElse

# Explicit casts are deliberately named by their result type. There is no
# implicit conversion between ordinary expressions.

# ── query pipeline ─────────────────────────────────────────────────────────

table : string -> string -> query r = primitive "__table"

where : expr r bool -> query r -> query r = primitive "__where"
select : expr r (row s) -> query r -> query s = primitive "__select"

# `update {..}` is `select` merged over the input row: a name the input
# already has keeps its position and takes the new expression, and a name it
# does not have is appended. Columns not listed are passed through.
update : expr r (row s) -> query r -> query s = primitive "__update"

# `omit "k"` drops one column. The checker needs no rule of its own for this:
# it is the row equation `input ~ { k : t | output }`.
omit : expr r string -> query r -> query s = primitive "__omit"

# `mapKeys f` transforms column names using a KeyMapper.
# f has kind KeyMapper, and the result type applies that mapper to row r.
mapKeys = __mapKeys

# `mapKeys2 f` transforms column names using a function expression.
# The function is evaluated at compile-time to determine output column names.
# Example: users & mapKeys2 (\x => "u_" <> x)
mapKeys2 = __mapKeys2

# `mapValue f` transforms all field types using a ValueMapper.
# f has kind ValueMapper, and the result type applies that mapper to row r.
mapValue : ValueMapper f -> query r -> query (mapValue f r) = primitive "__mapValue"

# `prefix "str"` prepends `str` to every column name.
prefix : string -> query r -> query (mapKey f r) = primitive "__prefix"

# `suffix "str"` appends `str` to every column name.
suffix : string -> query r -> query (mapKey f r) = primitive "__suffix"

# `merge left right` combines two queries; fields from right overwrite duplicates from left.
merge : query r -> query s -> query (merge r s) = primitive "__merge"

agg : expr r (row s) -> query r -> query s = primitive "__agg"

# `order [asc .x, desc .y]`; NULLs sort last in either direction.
order : expr r (list dir) -> query r -> query r = primitive "__order"

limit : expr r int -> query r -> query r = primitive "__limit"

offset : expr r int -> query r -> query r = primitive "__offset"

distinct : query r -> query r = primitive "__distinct"

inList : query r -> expr s a -> expr s bool = primitive "__in"
in = inList

asc : expr r a -> dir = primitive "__asc"

desc : expr r a -> dir = primitive "__desc"

group : expr r (list a) -> query r -> query r = primitive "__group"

# Stage shorthands. The first line of each pair declares a symbol; the second
# defines what it means. Both halves live here, and that is the whole cost of a
# shorthand — nothing in Rust knows about `&+`:
#
#   infixl 1 &^                  # declare: same level as `&`, so a stage
#   _&^_ = q => fields => ...    # define: what the shorthand does
#
# Level 1 is where `&` itself is declared (above, with the other combinators),
# and that is what makes these pipeline stages rather than ordinary operators:
# the pipe level is not a special class of operator, it is `&`'s precedence, and
# anything declared there chains like `&` and binds looser than every
# expression operator.
infixl 1 &?
infixl 1 &=
infixl 1 &+
infixl 1 &*
infixl 1 &.
infixl 1 &-

_&?_ = q => pred => where pred q
_&=_ = q => fields => select fields q
_&+_ = q => fields => update fields q
_&*_ = q => fields => agg fields q
_&._ = q => keys => order keys q
_&-_ = q => n => limit n q

# `left & innerJoin right (.<k == .>k)`
# Outer joins make the columns of the side that may be missing `maybe`.
# The output has the left input's columns, then the right input's that the
# left does not have: on a shared name the left column wins. To keep both,
# rename one side in a `select` before the join (a field list is written by
# hand, so the new name is just the name you write).
innerJoin : query r -> query s -> expr (merge r s) bool -> query (merge r s) = primitive "__innerJoin"

leftJoin : query r -> query s -> expr (merge r (mapValue maybe s)) bool -> query (merge r (mapValue maybe s)) = primitive "__leftJoin"

rightJoin : query r -> query s -> expr (merge (mapValue maybe r) s) bool -> query (merge (mapValue maybe r) s) = primitive "__rightJoin"

fullJoin : query r -> query s -> expr (merge (mapValue maybe r) (mapValue maybe s)) bool -> query (merge (mapValue maybe r) (mapValue maybe s)) = primitive "__fullJoin"
semiJoin : query r -> query s -> expr (merge r s) bool -> query r = primitive "__semiJoin"
antiJoin : query r -> query s -> expr (merge r s) bool -> query r = primitive "__antiJoin"

# Set operations require both queries to have the same row. They preserve the
# columns and order of the left input; SQL uses the corresponding set operator.
union : query r -> query r -> query r = primitive "__union"
intersect : query r -> query r -> query r = primitive "__intersect"
except : query r -> query r -> query r = primitive "__except"

# Join operators, between `&` and every expression operator:
# `users & teachers ? .<user_name == .>teacher_name`. The `<` / `>` mark the
# side whose rows are all kept: `<?` left, `?>` right, `<?>` both. They are
# declared like everything else; being at level 3 rather than `&`'s level 1 is
# what makes them ordinary operators that build a query rather than stages.
infixl 3 ?
infixl 3 <?
infixl 3 ?>
infixl 3 <?>

_?_ = innerJoin
_<?_ = leftJoin
_?>_ = rightJoin
_<?>_ = fullJoin

# `select {a = .a, b = .b}` is written `select {.a, .b}`. To recompute or
# rename a column use `update`, which keeps the row and merges over it.

# ── aggregates (depth 1: arguments must be row expressions) ───────────────
# Type variables in signatures are non-null; nullable inputs must be handled
# explicitly with `coalesce`.
# `sum` / `avg` / `min` / `max` are NULL for an all-NULL or empty input, so
# they return `maybe`: write `coalesce 0 (sum .x)` for a number.


# ── window functions (depth 1) ────────────────────────────────────────────
# spec = { partition = [..], order = [asc .x, desc .y], frame = .. }

# `lag` / `lead` are NULL at the partition edge; frames may be empty.

rows : bound -> bound -> frame = primitive "__rows"
unboundedPreceding : bound = primitive "__unboundedPreceding"
unboundedFollowing : bound = primitive "__unboundedFollowing"
currentRow : bound = primitive "__currentRow"
preceding : expr r int -> bound = primitive "__preceding"
following : expr r int -> bound = primitive "__following"
wholePartition = rows unboundedPreceding unboundedFollowing
runningFrame = rows unboundedPreceding currentRow

# ── scalar operators and functions ────────────────────────────────────────

_==_ : expr r a -> expr r a -> expr r bool = sql "$1 = $2"
_!=_ : expr r a -> expr r a -> expr r bool = sql "$1 <> $2"
_<_ : expr r a -> expr r a -> expr r bool = sql "$1 < $2"
_<=_ : expr r a -> expr r a -> expr r bool = sql "$1 <= $2"
_>_ : expr r a -> expr r a -> expr r bool = sql "$1 > $2"
_>=_ : expr r a -> expr r a -> expr r bool = sql "$1 >= $2"
_&&_ : expr r bool -> expr r bool -> expr r bool = sql "$1 AND $2"
_||_ : expr r bool -> expr r bool -> expr r bool = sql "$1 OR $2"

# Arithmetic is overloaded on int and float (no implicit conversions). On
# ints, `/` truncates toward zero and `%` keeps the dividend's sign, in every
# dialect.
_+_ : expr r int -> expr r int -> expr r int = sql "$1 + $2"
_+_ : expr r float -> expr r float -> expr r float = sql "$1 + $2"
_-_ : expr r int -> expr r int -> expr r int = sql "$1 - $2"
_-_ : expr r float -> expr r float -> expr r float = sql "$1 - $2"
_*_ : expr r int -> expr r int -> expr r int = sql "$1 * $2"
_*_ : expr r float -> expr r float -> expr r float = sql "$1 * $2"
_/_ : expr r int -> expr r int -> expr r int = sql "CAGARA_IDIV($1, $2)"
_/_ : expr r float -> expr r float -> expr r float = sql "$1 / $2"
_%_ : expr r int -> expr r int -> expr r int = sql "CAGARA_MOD($1, $2)"

# String concatenation, right-assoc and looser than arithmetic:
# `.first <> " " <> .last`.
_<>_ : expr r string -> expr r string -> expr r string = sql "$1 || $2"
concat = _<>_

# Positions are 1-based, as in SQL. `substring start len s`.
# `replaceAll from to s`: every occurrence. (SQL's REPLACE, not column renaming
# — use `update` for that.)
# TODO: replaceAll : string -> string -> expr r string -> expr r string = sql "REPLACE($3, $1, $2)"
# `strpos sub s`: position of the first `sub` in `s`; 0 if absent.
# Plain substring tests (`contains "@" .email`): `%` and `_` are not wildcards.
# TODO: startsWith : string -> expr r string -> expr r bool = sql "CAGARA_LEFT($2, CAGARA_LENGTH($1)) = $1"
# TODO: endsWith : string -> expr r string -> expr r bool = sql "CAGARA_RIGHT($2, CAGARA_LENGTH($1)) = $1"


# ── dates and timestamps ───────────────────────────────────────────────────
# String literals widen to `date` / `timestamp`: `.created_at >= "2024-01-01"`.
# Weeks start on Monday (ISO). `dayOfWeek` is 0 for Sunday.

# TODO: now = currentTimestamp


# `addDays 7 .created_at`; negative counts go back. Weeks and quarters are
# defined here as 7 days and 3 months, so the core needs only DAY and MONTH.
# TODO: addDays : int -> expr r timestamp -> expr r timestamp = sql "CAGARA_ADD('TIMESTAMP', 'DAY', $2, $1)"
# TODO: addMonths : int -> expr r timestamp -> expr r timestamp = sql "CAGARA_ADD('TIMESTAMP', 'MONTH', $2, $1)"
# TODO: addYears : int -> expr r timestamp -> expr r timestamp = sql "CAGARA_ADD('TIMESTAMP', 'YEAR', $2, $1)"
# TODO: addHours : int -> expr r timestamp -> expr r timestamp = sql "CAGARA_ADD('TIMESTAMP', 'HOUR', $2, $1)"
# TODO: addMinutes : int -> expr r timestamp -> expr r timestamp = sql "CAGARA_ADD('TIMESTAMP', 'MINUTE', $2, $1)"
# TODO: addSeconds : int -> expr r timestamp -> expr r timestamp = sql "CAGARA_ADD('TIMESTAMP', 'SECOND', $2, $1)"

# date_trunc: the start of the period containing the value, same type.

# Fields as integers.

# `daysBetween start end`: whole days from `start` to `end` (negative if
# `end` is earlier), so `daysBetween .created_at` is a function of the end.

# ── nulls: operators need non-null arguments, so nulls are handled here ────

# `coalesce default x`, like Haskell's `fromMaybe`; infix `x ?? default`
# (right-assoc, tighter than arithmetic: `.a ?? .b ?? 0`, `.n ?? 0 + 1`).
_??_ : expr r (maybe a) -> expr r a -> expr r a = sql "COALESCE($1, $2)"
# NULL counts as false, as in `where`.
