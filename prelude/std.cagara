-- Cagara standard library — the functions a query reaches for, not the ones
-- the language needs.
--
-- String and math functions, casts, date arithmetic and the nullable-aggregate
-- helpers. They are ordinary definitions (`sql "..."` templates or lambdas),
-- which is the whole point: the compiler does not know any of these names.
-- `core.cagara` is what it cannot do without; this file is what you cannot do
-- without.

-- ── scalar SQL expressions ─────────────────────────────────────────────────

--- Typed conditional: `ifThenElse p a b` is a searched `CASE WHEN p THEN a ELSE b`.
---
--- Both branches are checked at the same expression phase, so it also works
--- after `agg` or `select` when the surrounding stage permits that phase.
ifThenElse : expr ?r bool -> expr ?r ?a -> expr ?r ?a -> expr ?r ?a =
  sql "CASE WHEN $1 THEN $2 ELSE $3 END"

--- Case-style alias of `ifThenElse`, for reading a chain as if/else. Multi-way
--- conditionals are written with the `case { p => a; ... }` form instead.
caseWhen : expr ?r bool -> expr ?r ?a -> expr ?r ?a -> expr ?r ?a = ifThenElse

--- `countOf` for a nullable column. `countOf` accepts one directly — `COUNT(x)`
--- skips NULLs by definition, which is what counting the non-null values of a
--- nullable column *is* — so this spelling is an alias, kept because queries
--- written against it should keep working.
countOfMaybe : expr ?r (maybe ?a) -> agg (expr ?r int) = countOf

--- `countDistinct` for a nullable column; an alias, like `countOfMaybe`.
countDistinctMaybe : expr ?r (maybe ?a) -> agg (expr ?r int) = countDistinct

-- Filtered aggregates apply a predicate to the aggregate's *input* rows, the
-- portable spelling of SQL's `agg(x) FILTER (WHERE p)`. The predicate is a
-- non-null row-phase `bool` and cannot contain an aggregate or window. The
-- `CASE` omits `ELSE`, so a group with no matching row is NULL for the value
-- aggregates and 0 for the counts, exactly as `FILTER` gives. When every
-- aggregate in a stage shares one predicate, prefer `where` before `agg`: it
-- filters the rows once instead of once per aggregate.
--
-- The count forms use `COUNT(...)`, not `SUM(1)`: `SUM` is NULL when nothing
-- matches, while `COUNT(*) FILTER` is 0.

--- String concatenation, right-associative and looser than arithmetic, so
--- `"a" <> .b <> "c"` groups as `"a" <> (.b <> "c")` and `x + 1 <> "!"` needs
--- no parentheses. NULL if either side is NULL.
_++_ : expr ?r string -> expr ?r string -> expr ?r string = sql "$1 || $2"

--- `concat a b` is `a ++ b`, for a call site where an operator reads worse.
concat : expr ?r string -> expr ?r string -> expr ?r string = _++_

--- `a <> b` — combine, in the sense Haskell's `<>` has: an operation on one
--- type that is associative. Two instances exist, because two are what SQL can
--- express: `string` is concatenation, and `maybe string` is "whichever side is
--- present, concatenated when both are", whose identity is `nothing`.
---
--- This is why `<>` is not a second spelling of `++`. `++` is string
--- concatenation and says so in its type; `<>` is the combining operator, so it
--- also has a `maybe` instance — and that instance *ignores* a `nothing` rather
--- than letting it swallow the other side, which is not what `||` does.
_<>_ : expr ?r string -> expr ?r string -> expr ?r string = sql "$1 || $2"
_<>_ : expr ?r (maybe string) -> expr ?r (maybe string) -> expr ?r (maybe string) =
  sql "COALESCE($1 || $2, $1, $2)"
--- `a <> b` on lists: the same combining operation on a third type, and what
--- makes two `arrayAgg` results compose across a grouping. `CAGARA_LIST_CONCAT`
--- is `||` on PostgreSQL and `list_concat` on DuckDB; a dialect with no `list`
--- type refuses the query rather than writing something else.
_<>_ : expr ?r (list ?a) -> expr ?r (list ?a) -> expr ?r (list ?a) =
  sql "CAGARA_LIST_CONCAT($1, $2)"

--- Boolean negation.
not : expr ?r bool -> expr ?r bool = sql "NOT $1"

--- Arithmetic negation, overloaded on `int` and `float`.
negate : expr ?r int -> expr ?r int = sql "-$1"
negate : expr ?r float -> expr ?r float = sql "-$1"
--- A `decimal p s` negates exactly, and the result keeps the declared `(p,s)`:
--- a refund line is the same money with the opposite sign, not a wider type.
negate : expr ?r (decimal ?p ?s) -> expr ?r (decimal ?p ?s) = sql "-($1)"

--- Uppercase a string, in the database's collation.
upper : expr ?r string -> expr ?r string = sql "UPPER($1)"

--- Lowercase a string, in the database's collation.
lower : expr ?r string -> expr ?r string = sql "LOWER($1)"

--- Strip leading and trailing whitespace.
trim : expr ?r string -> expr ?r string = sql "TRIM($1)"

--- Strip leading whitespace.
ltrim : expr ?r string -> expr ?r string = sql "LTRIM($1)"

--- Strip trailing whitespace.
rtrim : expr ?r string -> expr ?r string = sql "RTRIM($1)"

--- `lpad 12 "0" s`: `s` padded on the left to width 12 with copies of `"0"`.
---
--- The width comes first, then what to pad with, then the string — the same
--- argument order as `left` / `right` / `substring`, which take their position
--- or length before the string, so `lpad 12 "0"` is a reusable "pad to twelve".
--- It is the reverse of SQL's own `LPAD(s, 12, '0')`, which is what the
--- template below rearranges.
---
--- A value already at least `n` wide is returned whole, not truncated.
---
--- SQLite has neither `LPAD` nor `REPEAT`, so `CAGARA_LPAD` builds the padding from
--- `HEX(ZEROBLOB(n))` — the character `0` repeated `2n` times, with each `0` replaced by
--- the fill. Works on every dialect, so this is not a compile error anywhere.
lpad : expr ?r int -> expr ?r string -> expr ?r string -> expr ?r string =
  sql "CAGARA_LPAD($1, $2, $3)"

--- `rpad 12 "0" s`: `s` padded on the right, the mirror of `lpad`.
rpad : expr ?r int -> expr ?r string -> expr ?r string -> expr ?r string =
  sql "CAGARA_RPAD($1, $2, $3)"

--- The number of characters in a string — characters, not bytes, in every
--- dialect (`CAGARA_LENGTH`).
length : expr ?r string -> expr ?r int = sql "CAGARA_LENGTH($1)"

--- `like "%foo%" .name`: SQL `LIKE`, so `%` and `_` are wildcards. The pattern
--- comes first to keep the subject last; for a plain substring test use
--- `contains`.
---
--- Case-sensitive everywhere, including SQLite. SQLite's own `LIKE` is
--- case-insensitive for ASCII unless the connection turns that off, so the
--- template is `CAGARA_LIKE` and the SQLite spelling is a `GLOB` with the pattern's
--- metacharacters translated. Without that, the same program matched `"ABC"`
--- there and did not on every other engine.
like : expr ?r string -> expr ?r string -> expr ?r bool = sql "CAGARA_LIKE($1, $2)"

--- Case-insensitive `like`. Not every engine has `ILIKE`, so the template is
--- `CAGARA_ILIKE`: SQLite gets both sides folded through `LOWER`.
---
--- That fold is ASCII-only, because SQLite's case mapping is: `ilike "%é%" "É"`
--- does not match there. `upper`/`lower` have the same limit.
ilike : expr ?r string -> expr ?r string -> expr ?r bool = sql "CAGARA_ILIKE($1, $2)"

--- `substring start len s`, 1-based as in SQL and `len` characters long.
substring : expr ?r int -> expr ?r int -> expr ?r string -> expr ?r string =
  sql "SUBSTRING($3, $1, $2)"

--- `left n s`: the first `n` characters.
left : expr ?r int -> expr ?r string -> expr ?r string = sql "CAGARA_LEFT($2, $1)"

--- `right n s`: the last `n` characters.
right : expr ?r int -> expr ?r string -> expr ?r string = sql "CAGARA_RIGHT($2, $1)"

--- `replaceAll from to s`: every occurrence of `from` in `s` replaced by `to`.
--- (SQL's `REPLACE`, not column renaming — use `update` for that.)
replaceAll : expr ?r string -> expr ?r string -> expr ?r string -> expr ?r string =
  sql "REPLACE($3, $1, $2)"

--- `strpos sub s`: the 1-based position of the first `sub` in `s`, or 0 when it
--- is absent.
strpos : expr ?r string -> expr ?r string -> expr ?r int = sql "CAGARA_STRPOS($2, $1)"

--- `contains "@" .email`: whether `s` contains `sub`. A plain substring test —
--- `%` and `_` are not wildcards here, which is the difference from `like`.
contains : expr ?r string -> expr ?r string -> expr ?r bool = sql "CAGARA_STRPOS($2, $1) > 0"

--- `startsWith "@" .domain`: whether `s` begins with `prefix`.
startsWith : expr ?r string -> expr ?r string -> expr ?r bool =
  sql "CAGARA_LEFT($2, CAGARA_LENGTH($1)) = $1"

--- `endsWith ".com" .domain`: whether `s` ends with `suffix`.
endsWith : expr ?r string -> expr ?r string -> expr ?r bool =
  sql "CAGARA_RIGHT($2, CAGARA_LENGTH($1)) = $1"

--- `position sub s`: the 1-based position of the first `sub` in `s`, or 0 when it is
--- absent — the same answer `strpos` gives, under SQL's own name for it. `STRPOS` is
--- spelled `INSTR` on SQLite and `LOCATE` on MySQL, which `CAGARA_STRPOS` already
--- handles, so this is an alias rather than a second implementation.
position : expr ?r string -> expr ?r string -> expr ?r int = strpos

--- `ascii s`: the code point of the first character of `s`, or 0 for an empty string.
---
--- `ASCII` on DuckDB and MySQL, `UNICODE` on SQLite and PostgreSQL — the latter is the
--- more honest name, since the answer is a code point and not a byte.
ascii : expr ?r string -> expr ?r int = sql "CAGARA_ASCII($1)"

--- `chr n`: the character whose code point is `n`.
---
--- `CHR` on DuckDB, MySQL, PostgreSQL and Trino; SQLite spells it `CHAR`. The
--- `CAGARA_CHR` rewrite covers the two.
chr : expr ?r int -> expr ?r string = sql "CAGARA_CHR($1)"

--- `repeat n s`: `s` repeated `n` times.
---
--- `REPEAT` on DuckDB, MySQL, PostgreSQL and Trino; SQLite has no such function, and
--- `replace(hex(zeroblob(n)), '00', s)` is the spelling there — `hex` writes the `n`
--- zero bytes as `2n` characters, so replacing each *pair* gives exactly `n` copies.
--- Measured on all four.
repeat : expr ?r int -> expr ?r string -> expr ?r string = sql "CAGARA_REPEAT($2, $1)"

--- `reverse s`: the characters of `s` in the opposite order.
---
--- `REVERSE` on DuckDB, MySQL, PostgreSQL and Trino. SQLite has none, so
--- `CAGARA_REVERSE` is a scalar subquery carrying its own `WITH RECURSIVE` that walks
--- the characters from the end — a recursive CTE is allowed inside an expression, which
--- is what makes this portable rather than a refusal.
reverse : expr ?r string -> expr ?r string = sql "CAGARA_REVERSE($1)"

-- Math is scalar and non-null.

--- Absolute value, overloaded on `int` and `float`.
abs : expr ?r int -> expr ?r int = sql "ABS($1)"
abs : expr ?r float -> expr ?r float = sql "ABS($1)"
--- The magnitude of money, exact and at the declared `(p,s)` — a variance is the
--- same units with the sign dropped.
abs : expr ?r (decimal ?p ?s) -> expr ?r (decimal ?p ?s) = sql "ABS($1)"

--- Round to the nearest integer, keeping the `float` type. Engines round ties
--- differently; this leaves that to the target rather than pretending one rule
--- is universal.
round : expr ?r float -> expr ?r float = sql "ROUND($1)"
round : expr ?r (decimal ?p ?s) -> expr ?r (decimal ?p ?s) = sql "ROUND($1)"

--- `roundTo 2 .amount`: round to `digits` decimal places. Digits first, subject
--- last, so `roundTo 2` is a reusable transformation.
roundTo : expr ?r int -> expr ?r float -> expr ?r float = sql "ROUND($2, $1)"
roundTo : expr ?r int -> expr ?r (decimal ?p ?s) -> expr ?r (decimal ?p ?s) = sql "ROUND($2, $1)"

--- Round down to the nearest integer, as a `float`.
floor : expr ?r float -> expr ?r float = sql "FLOOR($1)"

--- Round up to the nearest integer, as a `float`.
ceil : expr ?r float -> expr ?r float = sql "CEILING($1)"

--- Square root. A negative input is the engine's error or NULL, not a
--- documented value of this function.
sqrt : expr ?r float -> expr ?r float = sql "SQRT($1)"

--- `power exponent base`: `base` raised to `exponent`. Subject last, so
--- `power 2` squares its argument.
power : expr ?r float -> expr ?r float -> expr ?r float = sql "POWER($2, $1)"

--- Sign of a number: -1, 0 or 1. Overloaded on `int` and `float`.
sign : expr ?r int -> expr ?r int = sql "SIGN($1)"
--- `SIGN` is integer-valued in SQL — -1, 0 or 1 — so a `float` input gives an
--- `int`. It used to give a `float`, which made a `case` arm comparing against
--- `0` need `0.0` for no reason.
sign : expr ?r float -> expr ?r int = sql "CAST(SIGN($1) AS BIGINT)"

-- Exponentials and logarithms. `exp` and `ln` are spelled the same on every target
-- that has them; the logarithms are named for their base, because the bare `log`
-- does not mean one thing: DuckDB and SQLite read `log(x)` as base 10, MariaDB reads
-- it as the natural logarithm, and Trino refuses the one-argument form outright.
-- A name that means three things is not a name, so there is no `log`.

--- `e` raised to a power.
exp : expr ?r float -> expr ?r float = sql "EXP($1)"

--- The natural logarithm — the inverse of `exp`. Named for its base, like the two
--- below: `log` alone means base 10 on DuckDB and SQLite and base `e` on MariaDB,
--- so the language does not offer it.
ln : expr ?r float -> expr ?r float = sql "LN($1)"

--- The base-10 logarithm. `LOG10` on DuckDB, SQLite, MariaDB, Trino and Snowflake;
--- the `CAGARA_LOG10` rewrite covers the targets that spell it otherwise.
log10 : expr ?r float -> expr ?r float = sql "CAGARA_LOG10($1)"

--- The base-2 logarithm. PostgreSQL has no `LOG2`, so `CAGARA_LOG2` spells it as
--- `ln x / ln 2` there and as `LOG2` everywhere else.
log2 : expr ?r float -> expr ?r float = sql "CAGARA_LOG2($1)"

--- `logBase base x`: the logarithm of `x` to `base`.
---
--- Written as `ln x / ln base` rather than as the two-argument `LOG(base, x)`, which
--- every engine *runs* the same way — measured on DuckDB, SQLite, MariaDB and Trino —
--- but which `sqlglot-rust` does not *generate* the same way: a template
--- `LOG($1, $2)` comes back out as `LOG(x, base)`, so `logBase 2.0 8.0` lowered to
--- `LOG(8.0, 2.0)` and answered `0.333` instead of `3`. The division has no such
--- ambiguity and is exact on all four.
logBase : expr ?r float -> expr ?r float -> expr ?r float = base => x => ln x / ln base

--- Cube root. `CBRT` exists on DuckDB, Trino and MariaDB but not on SQLite, so this
--- is `exp(ln|x| / 3)` with the sign put back, which is what
--- `power(abs(x), 1.0/3)` gets wrong on MariaDB (`1.9999999986` for 8). The emulation
--- is within a float ulp of the native call — `cbrt 27.0` is `3.0000000000000004` on
--- DuckDB — so it is exact for the values a report shows and not bit-identical to
--- `CBRT`.
---
--- The `0` case is written out because `ln 0` is not a number the engines agree on:
--- SQLite answers NULL and DuckDB and PostgreSQL raise `cannot take logarithm of
--- zero`, so an unguarded emulation answered `0.0` on one engine and *failed the
--- query* on the others. The answer is `0` by definition, and `cbrt` is total.
cbrt : expr ?r float -> expr ?r float = x => ifThenElse (x == 0.0) 0.0 (
  toFloat (sign x) * exp (ln (abs x) / 3)
)

--- Degrees from radians.
degrees : expr ?r float -> expr ?r float = sql "DEGREES($1)"

--- Radians from degrees.
radians : expr ?r float -> expr ?r float = sql "RADIANS($1)"

--- `random` draws a float in `[0, 1)`. Use `order [asc random] & limit 10` to sample rows.
--- With `select { r = random }`, downstream reads of `.r` reuse the row's draw. For two
--- draws write `select { a = random, b = random }`; distinct draws need not be unequal.
random : expr ?r float = sql "CAGARA_RANDOM()"

--- `greatest a b`: the larger of two non-null values, of any ordered type.
--- SQLite has no `GREATEST`, so the `CASE` spelling is the portable one; with
--- non-null arguments no NULL has to be resolved.
greatest : expr ?r ?a -> expr ?r ?a -> expr ?r ?a = sql "CASE WHEN $1 >= $2 THEN $1 ELSE $2 END"

--- `least a b`: the smaller of two non-null values. Portable for the same
--- reason as `greatest`.
least : expr ?r ?a -> expr ?r ?a -> expr ?r ?a = sql "CASE WHEN $1 <= $2 THEN $1 ELSE $2 END"

--- Render a value as a string, overloading `int`, `float`, `date`, `timestamp`
--- and `bool`. The bool form is a `CASE` giving `'true'` / `'false'`, because
--- engines disagree about how they print a boolean.
toString : expr ?r int -> expr ?r string = sql "CAGARA_TO_STRING($1)"
toString : expr ?r float -> expr ?r string = sql "CAGARA_TO_STRING($1)"
toString : expr ?r (decimal ?p ?s) -> expr ?r string = sql "CAGARA_TO_STRING($1)"
toString : expr ?r date -> expr ?r string = sql "CAGARA_TO_STRING($1)"
toString : expr ?r timestamp -> expr ?r string = sql "CAGARA_TO_STRING($1)"
toString : expr ?r bool -> expr ?r string = sql "CASE WHEN $1 THEN 'true' ELSE 'false' END"

-- Casts are named for the type they produce. Overloading picks the one that
-- fits, so `toInt` applied to a `float` is a narrowing and `toInt` applied to a
-- `string` is a parse -- the same destination reached from different sources.

--- Convert to `int`: from a `float` it truncates toward zero, in every dialect
--- (`CAGARA_TRUNC_INT`); from a `string` it parses an integer and fails on a
--- value that is not one (`tryInt` yields NULL instead).
toInt : expr ?r float -> expr ?r int = sql "CAGARA_TRUNC_INT($1)"
toInt : expr ?r (decimal ?p ?s) -> expr ?r int = sql "CAGARA_TRUNC_INT($1)"
toInt : expr ?r string -> expr ?r int = sql "CAGARA_TO_INT($1)"

--- Convert to `float`, a 64-bit IEEE double: from an `int` exactly, from a
--- `string` by parsing.
toFloat : expr ?r int -> expr ?r float = sql "CAGARA_TO_FLOAT($1)"
toFloat : expr ?r string -> expr ?r float = sql "CAGARA_TO_FLOAT($1)"
--- The one door out of `decimal`: it is a lossy conversion, so it is written out.
toFloat : expr ?r (decimal ?p ?s) -> expr ?r float = sql "CAGARA_TO_FLOAT($1)"

--- Convert to `bool` from a number: zero is false, everything else true.
toBool : expr ?r int -> expr ?r bool = sql "CAST($1 AS BOOLEAN)"
toBool : expr ?r float -> expr ?r bool = sql "CAST($1 AS BOOLEAN)"

--- `toDecimal precision scale x` gives a value an exact SQL type. Money is the
--- reason: plain `FLOAT` is binary floating point, so sums of it drift, while
--- `DECIMAL(18, 2)` is exact. The *language* type stays `float` — there is no
--- separate decimal scalar — so this changes the SQL type without adding one.
--- Usable from `string`, `int` and `float` sources.
toDecimal : expr ?r int -> expr ?r int -> expr ?r string -> expr ?r (decimal ?p ?s) =
  sql "CAGARA_TO_DECIMAL($3, $1, $2)"
toDecimal : expr ?r int -> expr ?r int -> expr ?r int -> expr ?r (decimal ?p ?s) =
  sql "CAGARA_TO_DECIMAL($3, $1, $2)"
toDecimal : expr ?r int -> expr ?r int -> expr ?r float -> expr ?r (decimal ?p ?s) =
  sql "CAGARA_TO_DECIMAL($3, $1, $2)"
--- Re-scaling an existing decimal is a cast too, and the result's parameters are
--- its own: the source's `(p,s)` do not constrain where the value is going.
toDecimal : expr ?r int -> expr ?r int -> expr ?r (decimal ?p ?s) -> expr ?r (decimal ?q ?t) =
  sql "CAGARA_TO_DECIMAL($3, $1, $2)"

-- A `from*` name says where the value came from rather than where it is going,
-- which is the more useful reading at a call site: `fromString .man_grade` says
-- the column is text and is being read as a number. Each is the `to*` above,
-- so there is one implementation and two ways to name it.

--- `fromString` reads a `string` as the type the context asks for — `int`,
--- `float` or `date`. The `to*` cast with the direction named from the source.
fromString : expr ?r string -> expr ?r int = x => toInt x
fromString : expr ?r string -> expr ?r float = x => toFloat x
fromString : expr ?r string -> expr ?r date = x => toDate x

--- `fromInt` reads an `int` as a `float`: `toFloat` with the direction named
--- from the source.
fromInt : expr ?r int -> expr ?r float = x => toFloat x

--- `fromFloat` reads a `float` as an `int`, truncating toward zero.
fromFloat : expr ?r float -> expr ?r int = x => toInt x

-- The casts above fail on a value they cannot convert. For a column typed
-- `string` that holds a code -- and `icbase` has tens of thousands of those --
-- one bad row would otherwise fail the whole query, so the `try*` forms yield
-- NULL instead. They return `maybe`, because that NULL has to be handled
-- somewhere: `coalesce 0 (tryInt .x)`.

--- `tryInt` parses a `string` as an `int`, giving NULL where `toInt` would
--- fail. Always `maybe`, so the caller decides what a bad row means.
tryInt : expr ?r string -> expr ?r (maybe int) = sql "CAGARA_TRY_INT($1)"

--- `tryFloat` parses a `string` as a `float`, NULL on failure.
tryFloat : expr ?r string -> expr ?r (maybe float) = sql "CAGARA_TRY_FLOAT($1)"

--- `parseDate "%Y-%m-%d" s` — a `date` from a string, by format. One interface
--- for every target: PostgreSQL spells the format `YYYY-MM-DD` where the string
--- says `%Y-%m-%d`, MySQL reads `%i` for minutes where the string says `%M`, and
--- Spark writes `yyyy-MM-dd`; the translation happens here, not in your query.
---
--- The format is `%Y` (year), `%m` (month), `%d` (day), `%H` (hour), `%M`
--- (minute), `%S` (second) and `%%` for a literal percent — nothing else, so a
--- format that works on one target cannot mean something else on another. It
--- must be a literal: it is compiled into the SQL. A bad value raises, exactly
--- as the target's own parser does; use `toDate` when the shape is fixed and
--- `tryDate` when the input may not be a date at all.
parseDate : string -> expr ?r string -> expr ?r date = sql "CAGARA_PARSE_DATE($1, $2)"

--- `parseTimestamp "%Y-%m-%d %H:%M:%S" s` — the same, keeping the time of day.
--- `parseDate` drops it; this one is what a `%H`, `%M` or `%S` format wants.
parseTimestamp : string -> expr ?r string -> expr ?r timestamp =
  sql "CAGARA_PARSE_TIMESTAMP($1, $2)"

--- `formatDate "%Y-%m" d` — the inverse: a `date` printed by format, with the
--- same vocabulary as `parseDate`. `toString` is the fixed ISO spelling and needs
--- no format.
formatDate : string -> expr ?r date -> expr ?r string = sql "CAGARA_FORMAT_DATE($1, $2)"

--- `formatTimestamp "%Y-%m-%d %H:%M" t` — a `timestamp` printed by format, with
--- the same vocabulary as the rest.
formatTimestamp : string -> expr ?r timestamp -> expr ?r string =
  sql "CAGARA_FORMAT_TIMESTAMP($1, $2)"

--- `tryDate` parses a `string` as a `date`, NULL on failure.
tryDate : expr ?r string -> expr ?r (maybe date) = sql "CAGARA_TRY_DATE($1)"

--- `tryTimestamp` parses a `string` as a `timestamp`, NULL on failure.
tryTimestamp : expr ?r string -> expr ?r (maybe timestamp) = sql "CAGARA_TRY_TIMESTAMP($1)"

--- `tryDecimal precision scale x`: `toDecimal` for a `string` that may not be a
--- number, NULL on failure.
tryDecimal : expr ?r int -> expr ?r int -> expr ?r string -> expr ?r (maybe (decimal ?p ?s)) =
  sql "CAGARA_TRY_DECIMAL($3, $1, $2)"

-- ── dates and timestamps ───────────────────────────────────────────────────
-- String literals widen to `date` / `timestamp`: `.created_at >= "2024-01-01"`.
-- Weeks start on Monday (ISO). `dayOfWeek` is 0 for Sunday.

--- Today, as a `date`.
currentDate : date = sql "CURRENT_DATE"

--- The current instant, to the engine's precision.
currentTimestamp : timestamp = sql "CAGARA_NOW()"

--- Alias of `currentTimestamp`, under the shorter name.
now : expr ?r timestamp = currentTimestamp

--- The day before today. The most common partition date there is: a table
--- partitioned by day is read for the day that has finished, and `yesterday`
--- says that in one word at a use site where `addDays (-1) currentDate` is a
--- parenthesised expression in the middle of a pipeline.
yesterday : expr ?r date = addDays (-1) currentDate

--- Convert to `date`: from a `timestamp` it truncates to the day, from a
--- `string` it parses one.
toDate : expr ?r timestamp -> expr ?r date = sql "CAGARA_TO_DATE($1)"
toDate : expr ?r string -> expr ?r date = sql "CAGARA_TO_DATE($1)"

--- Convert to `timestamp`: from a `date` (midnight) or from a `string`.
toTimestamp : expr ?r date -> expr ?r timestamp = sql "CAGARA_TO_TIMESTAMP($1)"
toTimestamp : expr ?r string -> expr ?r timestamp = sql "CAGARA_TO_TIMESTAMP($1)"

--- `addDays 7 .created_at`: move a date or timestamp by whole days; negative
--- counts go back. Overloaded on `date` and `timestamp`, returning the type it
--- was given.
---
--- The week, quarter and year shifts below are defined from this one: 7 days,
--- 3 months, 1 year. So the core needs only `DAY` and `MONTH`.
addDays : expr ?r int -> expr ?r date -> expr ?r date = sql "CAGARA_ADD('DATE', 'DAY', $2, $1)"
addDays : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'DAY', $2, $1)"

--- `addWeeks 2 .d`: move by whole weeks, spelled as `addDays` of `n * 7`.
addWeeks : expr ?r int -> expr ?r date -> expr ?r date = sql "CAGARA_ADD('DATE', 'DAY', $2, $1 * 7)"
addWeeks : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'DAY', $2, $1 * 7)"

--- `addMonths 1 .d`: move by calendar months. The engine decides what the 31st
--- of a month without a 31st becomes.
addMonths : expr ?r int -> expr ?r date -> expr ?r date = sql "CAGARA_ADD('DATE', 'MONTH', $2, $1)"
addMonths : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'MONTH', $2, $1)"

--- `addQuarters 1 .d`: move by quarters, spelled as `addMonths` of `n * 3`.
addQuarters : expr ?r int -> expr ?r date -> expr ?r date =
  sql "CAGARA_ADD('DATE', 'MONTH', $2, $1 * 3)"
addQuarters : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'MONTH', $2, $1 * 3)"

--- `addYears 1 .d`: move by calendar years.
addYears : expr ?r int -> expr ?r date -> expr ?r date = sql "CAGARA_ADD('DATE', 'YEAR', $2, $1)"
addYears : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'YEAR', $2, $1)"

--- `addHours 2 .t`: move a timestamp by whole hours. Timestamps only — a `date`
--- has no hour to move.
addHours : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'HOUR', $2, $1)"

--- `addMinutes 30 .t`: move a timestamp by whole minutes.
addMinutes : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'MINUTE', $2, $1)"

--- `addSeconds 30 .t`: move a timestamp by whole seconds.
addSeconds : expr ?r int -> expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_ADD('TIMESTAMP', 'SECOND', $2, $1)"

-- date_trunc: the start of the period containing the value, same type.

--- `truncYear .d`: the first instant of the containing year, in the input's own
--- type.
truncYear : expr ?r date -> expr ?r date = sql "CAGARA_TRUNC('DATE', 'YEAR', $1)"
truncYear : expr ?r timestamp -> expr ?r timestamp = sql "CAGARA_TRUNC('TIMESTAMP', 'YEAR', $1)"

--- `truncQuarter .d`: the first day of the containing quarter.
truncQuarter : expr ?r date -> expr ?r date = sql "CAGARA_TRUNC('DATE', 'QUARTER', $1)"
truncQuarter : expr ?r timestamp -> expr ?r timestamp =
  sql "CAGARA_TRUNC('TIMESTAMP', 'QUARTER', $1)"

--- `truncMonth .d`: the first day of the containing month — the usual spelling
--- of a monthly bucket.
truncMonth : expr ?r date -> expr ?r date = sql "CAGARA_TRUNC('DATE', 'MONTH', $1)"
truncMonth : expr ?r timestamp -> expr ?r timestamp = sql "CAGARA_TRUNC('TIMESTAMP', 'MONTH', $1)"

--- `truncWeek .d`: the Monday of the containing week.
truncWeek : expr ?r date -> expr ?r date = sql "CAGARA_TRUNC('DATE', 'WEEK', $1)"
truncWeek : expr ?r timestamp -> expr ?r timestamp = sql "CAGARA_TRUNC('TIMESTAMP', 'WEEK', $1)"

--- `truncDay .t`: midnight of the containing day, as a timestamp.
truncDay : expr ?r timestamp -> expr ?r timestamp = sql "CAGARA_TRUNC('TIMESTAMP', 'DAY', $1)"

--- `truncHour .t`: the start of the containing hour.
truncHour : expr ?r timestamp -> expr ?r timestamp = sql "CAGARA_TRUNC('TIMESTAMP', 'HOUR', $1)"

--- `truncMinute .t`: the start of the containing minute.
truncMinute : expr ?r timestamp -> expr ?r timestamp = sql "CAGARA_TRUNC('TIMESTAMP', 'MINUTE', $1)"

-- Fields as integers.

--- The year of a date or timestamp: `yearOfDate .created_at`.
---
--- Named `yearOfDate` and not `year` because a field *of* a value and a bucket
--- *of* a value are different questions, and `year` read as both. `group (year
--- .d)` looked like "group by year" and was `GROUP BY EXTRACT(YEAR …)` — correct,
--- by luck, because a year number is unique across years. `group (month .d)` was
--- not: `EXTRACT(MONTH …)` is 1–12, so every January in the table became one row.
--- The extractors say *which field*, the `trunc*` functions give a bucket, and the
--- names now say which is which.
yearOfDate : expr ?r date -> expr ?r int = sql "CAGARA_PART('DATE', 'YEAR', $1)"
yearOfDate : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'YEAR', $1)"

--- The quarter, 1–4.
quarter : expr ?r date -> expr ?r int = sql "CAGARA_PART('DATE', 'QUARTER', $1)"
quarter : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'QUARTER', $1)"

--- The month number, 1–12 — a *field*, not a bucket.
---
--- `group (monthOfYear .d)` groups January 2024 with January 2025, because both
--- are 1. That is what the name now says. For a month bucket use `truncMonth`,
--- whose result is a date: `group (truncMonth .d)`.
monthOfYear : expr ?r date -> expr ?r int = sql "CAGARA_PART('DATE', 'MONTH', $1)"
monthOfYear : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'MONTH', $1)"

--- The day of the month, 1–31 — a field, like `monthOfYear`. For a day bucket
--- use `truncDay`, whose result is a timestamp.
dayOfMonth : expr ?r date -> expr ?r int = sql "CAGARA_PART('DATE', 'DAY', $1)"
dayOfMonth : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'DAY', $1)"

--- The day of the week, 0 for Sunday — the numbering SQL engines use, not
--- ISO's.
dayOfWeek : expr ?r date -> expr ?r int = sql "CAGARA_PART('DATE', 'DOW', $1)"
dayOfWeek : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'DOW', $1)"

--- The day of the year, 1–366.
dayOfYear : expr ?r date -> expr ?r int = sql "CAGARA_PART('DATE', 'DOY', $1)"
dayOfYear : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'DOY', $1)"

--- The hour, 0–23, of a timestamp.
hour : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'HOUR', $1)"

--- The minute, 0–59, of a timestamp.
minute : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'MINUTE', $1)"

--- The second, 0–59, of a timestamp. `CAGARA_PART` already had `SECOND`; the field
--- was simply not exposed, which made `secondsBetween` unspellable.
second : expr ?r timestamp -> expr ?r int = sql "CAGARA_PART('TIMESTAMP', 'SECOND', $1)"

--- `daysBetween start end`: whole days from `start` to `end`, negative if `end`
--- is earlier. Subject last, so `daysBetween .created_at` is a function of the
--- end — an age in days.
daysBetween : expr ?r date -> expr ?r date -> expr ?r int = sql "CAGARA_DAYS_BETWEEN($1, $2)"

--- `monthsBetween start end`: whole calendar months from `start` to `end`.
---
--- The **elapsed** count, not the number of month boundaries crossed. Those differ
--- and the difference is not a rounding detail: `2024-01-31` to `2024-02-01` crosses
--- one boundary and no whole month has passed, so this says `0` where `DATE_DIFF`
--- says `1`. An age is elapsed months, which is why this is the definition — and why
--- it is written out here rather than delegated to each engine's `DATEDIFF`, which
--- does not agree on which of the two it means.
---
--- Measured equal on DuckDB, SQLite, MariaDB and Trino, because it is plain
--- `yearOfDate`/`monthOfYear`/`dayOfMonth` arithmetic and those are already portable.
monthsBetween : expr ?r date -> expr ?r date -> expr ?r int = a => b =>
  (yearOfDate b - yearOfDate a) * 12
  + (monthOfYear b - monthOfYear a)
  - ifThenElse (dayOfMonth b < dayOfMonth a) 1 0

--- `yearsBetween start end`: whole calendar years from `start` to `end`, elapsed in
--- the same sense as `monthsBetween` — `2020-05-01` to `2024-03-20` is `3`, because
--- the fourth year is not complete.
yearsBetween : expr ?r date -> expr ?r date -> expr ?r int = a => b => monthsBetween a b / 12

--- `secondsBetween start end`: whole seconds between two timestamps.
---
--- The elapsed duration, computed as whole days plus the difference between the two
--- times of day. Writing it the obvious way — subtracting the `hour` fields, then the
--- `minute` fields, then the `second` fields — is **wrong across midnight**:
--- `23:30` to `01:15` the next day is 105 minutes, but `hour` gives `1 - 23 = -22`
--- and the fields wrap independently, so the sum comes out as `2 * 60 - 15`. This
--- spelling has no such seam: the day part is already a whole number of days, and the
--- time of day is one signed quantity.
secondsBetween : expr ?r timestamp -> expr ?r timestamp -> expr ?r int = a => b =>
  daysBetween (toDate a) (toDate b) * 86400
  + ((hour b * 3600 + minute b * 60 + second b) - (hour a * 3600 + minute a * 60 + second a))

--- `minutesBetween start end`: whole minutes, from `secondsBetween` so the two cannot
--- disagree. Integer division truncates toward zero, so an interval of `-105` seconds
--- is `-1` minute rather than `-2`.
minutesBetween : expr ?r timestamp -> expr ?r timestamp -> expr ?r int = a => b =>
  secondsBetween a b / 60

--- `hoursBetween start end`: whole hours, from `secondsBetween` for the same reason.
hoursBetween : expr ?r timestamp -> expr ?r timestamp -> expr ?r int = a => b =>
  secondsBetween a b / 3600

--- `nullIf a b`: NULL when `a` equals `b`, `a` otherwise — how a sentinel value
--- is turned into a real NULL.
nullIf : expr ?r ?a -> expr ?r ?a -> expr ?r (maybe ?a) = sql "NULLIF($1, $2)"

--- Equality that treats two NULL values as equal, and never returns NULL — so
--- it can be used directly in `where` and in join predicates, where a plain
--- `==` between two nullables would filter everything out.
eqMaybe : expr ?r (maybe ?a) -> expr ?r (maybe ?a) -> expr ?r bool =
  sql "COALESCE(($1 = $2) OR ($1 IS NULL AND $2 IS NULL), FALSE)"

--- `between lo hi x`: whether `x` is within `[lo, hi]`, both ends included —
--- `where (between 1 10 .age)`.
---
--- The most-written analytics predicate, and the one shape a comparison chain
--- spells worst: `x >= lo && x <= hi` names `x` twice and reads in the wrong
--- order. Subject last, like every other predicate here.
between : expr ?r ?a -> expr ?r ?a -> expr ?r ?a -> expr ?r bool = lo => hi => x =>
  x >= lo && x <= hi

--- `ratio whole part`: `part / whole` as a `float`, and `0.0` when `whole` is
--- zero — a share that has no denominator is no share.
---
--- Subject last, like every other function here: `ratio .total .paid` is "what
--- part of the total is paid". Without it the spelling is
--- `toFloat part / toFloat whole`, which fails to compile on `int` (integer
--- division is `int`), and `100 * .a / .b` silently truncates to `0` or `1`.
---
--- Two overloads rather than one polymorphic definition: the language has no
--- numeric type class, so a body cannot do arithmetic on an `?a`. The `int` form
--- is the one a raw column needs; the `float` form is what a `sum` produces.
ratio : expr ?r int -> expr ?r int -> expr ?r float = whole => part => ifThenElse (whole == 0) 0.0 (
  toFloat part / toFloat whole
)
ratio : expr ?r float -> expr ?r float -> expr ?r float = whole => part => ifThenElse (
  whole == 0.0
) 0.0 (part / whole)

--- `percentOf whole part`: the same share out of a hundred —
--- `percentOf .total .paid` is the paid share as a percentage. Zero when `whole`
--- is zero, so a percentage column never needs a guard of its own.
percentOf : expr ?r int -> expr ?r int -> expr ?r float = whole => part => 100.0 * ratio whole part
percentOf : expr ?r float -> expr ?r float -> expr ?r float = whole => part =>
  100.0 * ratio whole part

--- `safeDiv b a`: `a / b`, or NULL when `b` (the divisor, and the first
--- argument) is zero — `safeDiv 0 .count` is "the count, divided by zero, or
--- nothing".
---
--- `/` is typed `int` and yields NULL at run time for a zero divisor on most
--- targets and raises on one, so a quotient that can be undefined is spelled
--- here so the checker makes the caller handle it. A `sql` template because the
--- result is `maybe` and a `case` cannot produce one (its arms share a type and
--- neither `nothing` nor `just` is the other's type) — the template also keeps
--- the integer-division rewrite, so it truncates like `/` does.
safeDiv : expr ?r int -> expr ?r int -> expr ?r (maybe int) =
  sql "CASE WHEN $1 = 0 THEN NULL ELSE CAGARA_IDIV($2, $1) END"

--- `safeMod b a`: `a % b`, or NULL when the divisor is zero. See `safeDiv`.
safeMod : expr ?r int -> expr ?r int -> expr ?r (maybe int) =
  sql "CASE WHEN $1 = 0 THEN NULL ELSE CAGARA_MOD($2, $1) END"

--- `weeksBetween start end`: whole weeks, from `daysBetween` so the two cannot
--- disagree.
weeksBetween : expr ?r date -> expr ?r date -> expr ?r int = a => b => daysBetween a b / 7

--- `quartersBetween start end`: whole quarters, from `monthsBetween` for the same
--- reason.
quartersBetween : expr ?r date -> expr ?r date -> expr ?r int = a => b => monthsBetween a b / 3

--- The ISO week number, 1–53: the week containing the year's first Thursday is
--- week 1, which is what `truncWeek` buckets by. Written from `dayOfYear` and
--- the weekday so it is the same number on every target — engines disagree about
--- `WEEKOFYEAR`, and some count from 0.
weekOfYear : expr ?r date -> expr ?r int = d => (dayOfYear d - dayOfWeek d + 10) / 7

--- A `bool` from text: `"true"`, `"t"`, `"yes"`, `"y"` and `"1"` are true;
--- `"false"`, `"f"`, `"no"`, `"n"` and `"0"` are false, case-insensitively.
---
--- Any other text reads as **false**, because a `CASE` cannot raise and the
--- alternative — a NULL — would not fit the non-null result. Use `tryBool` when
--- "not a boolean" has to be distinguishable from `false`.
toBool : expr ?r string -> expr ?r bool = s =>
  ifThenElse
    (inList ["true", "t", "yes", "y", "1"] (lower s))
    true
    (ifThenElse (inList ["false", "f", "no", "n", "0"] (lower s)) false false)

--- `tryBool s`: `toBool` for a column that may hold something else — NULL where
--- the text names neither.
---
--- Two templates, because a string literal cannot span a line and the whole
--- `CASE` is past the width: `tryBoolTrue` recognises the true spellings, and
--- this falls back to it. Composing two `maybe bool` values needs no `ifThenElse`
--- (whose type variable is non-null, so it cannot join a `just` with a `nothing`).
tryBool : expr ?r string -> expr ?r (maybe bool) = s => tryBoolOr (tryBoolTrue s) (tryBoolFalse s)

--- The first present `maybe bool`, still nullable when both are NULL.
tryBoolOr : expr ?r (maybe bool) -> expr ?r (maybe bool) -> expr ?r (maybe bool) = _??_

--- The true half of `tryBool`: `just true`, or NULL.
tryBoolTrue : expr ?r string -> expr ?r (maybe bool) =
  sql "CASE WHEN LOWER($1) IN ('true','t','yes','y','1') THEN TRUE END"

--- The false half of `tryBool`: `just false`, or NULL.
tryBoolFalse : expr ?r string -> expr ?r (maybe bool) =
  sql "CASE WHEN LOWER($1) IN ('false','f','no','n','0') THEN FALSE END"

--- `monthName d`: the month as its English name — `formatDate "%B" d`. A report
--- axis labelled with a month reads better than one labelled `3`.
monthName : expr ?r date -> expr ?r string = formatDate "%B"
monthName : expr ?r timestamp -> expr ?r string = formatTimestamp "%B"

--- `monthAbbrev d`: the month as its three-letter name — `formatDate "%b" d`.
monthAbbrev : expr ?r date -> expr ?r string = formatDate "%b"
monthAbbrev : expr ?r timestamp -> expr ?r string = formatTimestamp "%b"

--- `dayName d`: the weekday as its English name — `formatDate "%A" d`. "Traffic
--- by weekday" is a report that needs this and nothing else.
dayName : expr ?r date -> expr ?r string = formatDate "%A"
dayName : expr ?r timestamp -> expr ?r string = formatTimestamp "%A"

--- `dayAbbrev d`: the weekday as its three-letter name — `formatDate "%a" d`.
dayAbbrev : expr ?r date -> expr ?r string = formatDate "%a"
dayAbbrev : expr ?r timestamp -> expr ?r string = formatTimestamp "%a"
